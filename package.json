{
  "name": "@local/group-talk-l",
  "version": "2.3.1",
  "type": "module",
  "description": "群聊 Group-Chat (Group-Talk-L): a full-area cross-session group chat for DeepSeek Harness. The person talks to existing sessions through @alias, #role or * routing, with role assignment, human-priority delivery, audited secretary/organizer notes, bounded subagent delegation, dedupe, fan-out caps and daily token budgets. Each session keeps its own context, model and workspace.",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "README.en.md",
    "DESIGN.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs",
    ".github",
    "REVIEW-RESPONSE.md",
    "screenshots.json"
  ],
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "group-talk-l",
    "group-chat",
    "群聊",
    "cross-session",
    "multi-agent",
    "collaboration"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "author": "Group-Talk-L contributors",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "for f in lib/*.js; do node --check \"$f\"; done"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Leica-Shen/deepseek-harness-group-chat.git"
  },
  "homepage": "https://github.com/Leica-Shen/deepseek-harness-group-chat#readme",
  "bugs": {
    "url": "https://github.com/Leica-Shen/deepseek-harness-group-chat/issues"
  }
}
